# Optional private OpenAI-compatible inference service. Browser mode works
# without these values. Supply the actual model ID exposed by your server.
ARCHINDUS_QWEN_ENDPOINT=
ARCHINDUS_QWEN_MODEL=
ARCHINDUS_QWEN_API_KEY=

# Server-only hosted inference. Add the secret in Sites runtime settings.
# Requires the DB binding and generated Drizzle migration. Disabled by default.
OPENAI_API_KEY=
ARCHINDUS_HOSTED_ENABLED=false
ARCHINDUS_DAILY_USD=1
ARCHINDUS_MONTHLY_USD=10

# Main Archindus voice (server secret; never prefix with NEXT_PUBLIC_ / VITE_).
# The configured voice ID is 8FWNPj6rjBosEZ2EXARh.
ELEVENLABS_API_KEY=
